{
  "name": "intent-admin-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/generate-pages.mjs && cross-env PORT=5173 max dev",
    "build": "node scripts/generate-pages.mjs && max build && node scripts/precompress.mjs",
    "preview": "max preview --port 5173",
    "lint": "biome lint src config && tsc --noEmit",
    "test": "vitest run",
    "setup": "node scripts/generate-pages.mjs && max setup",
    "typecheck": "tsc --noEmit",
    "i18n:check": "node scripts/localize-source.mjs --check",
    "postinstall": "node scripts/generate-pages.mjs && max setup"
  },
  "dependencies": {
    "@ant-design/cssinjs": "^1.23.0",
    "@ant-design/icons": "^6.0.0",
    "@ant-design/pro-components": "3.1.14-2",
    "@tailwindcss/postcss": "4.3.3",
    "antd": "^6.0.0",
    "antd-style": "4.1.0",
    "axios": "^1.13.1",
    "dayjs": "1.11.23",
    "echarts": "^6.0.0",
    "echarts-for-react": "^3.0.5",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "6.3.0",
    "remark-gfm": "^4.0.1",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@tailwindcss/webpack": "4.3.3",
    "@types/node": "^24.9.1",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.1",
    "@umijs/max": "4.7.27",
    "cross-env": "10.1.0",
    "tailwindcss": "^4.1.14",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "description": "Intent Admin frontend based on Ant Design Pro v6 / Umi Max"
}
