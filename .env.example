# Docker Compose development defaults. APP_ENV=prod rejects the example JWT
# and encryption keys. Generate each production key with: openssl rand -base64 32
APP_ENV=dev
APP_PORT=8080
PUBLIC_URL=http://localhost:8080
JWT_SECRET=change-me-in-production
ENCRYPT_KEY=0123456789abcdef0123456789abcdef
POSTGRES_PASSWORD=intent-local-only
REDIS_PASSWORD=intent-redis-local-only
MINIO_ROOT_USER=intent-minio
MINIO_ROOT_PASSWORD=intent-minio-local-only

# Default private S3 bucket. Set both STORAGE_DRIVER=local and STORAGE_URL_MODE=static to use disk.
STORAGE_DRIVER=s3
STORAGE_URL_MODE=presigned
STORAGE_PUBLIC_URL=http://localhost:9000/intent-admin

# Canonical public origin used by MCP OAuth discovery and callbacks.
MCP_OAUTH_ISSUER=http://127.0.0.1:8080
